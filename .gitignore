# --- Environnement Virtuel ---
# Exclut le dossier de l'environnement virtuel Python
env/
venv/
*.venv

# --- Fichiers de Cache Python ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Fichiers de Configuration Générés ---
# Ne pas versionner le fichier de configuration utilisateur pour permettre
# une configuration par défaut sur chaque nouvelle machine.
user_config.json

# --- Fichiers de Configuration de l'Éditeur ---
.vscode/
.idea/

# --- Fichiers de Build/Distribution ---
build/
dist/
*.egg-info/

# --- Fichiers de moteur de traduction de test (non utilisés en production) ---
moteur_trad_pi/mot_traduc*.py
moteur_trad_pi/moteur_traduction_pi.py
moteur_trad_pi/requirements.txt

# --- Modèles ML lourds (à télécharger séparément) ---
moteur_trad_pi/Model/*.tflite
moteur_trad_pi/Model/*.gguf
moteur_trad_pi/piper/

# --- Fichiers Bluetooth de test (non utilisés en production) ---
bt_manage3.py
bt_manager.py
test_bluetooth.py
bluetooth_manager_1.py

# --- Dossiers et fichiers vides ou inutilisés ---
src/modules/
boot_service/start_service.sh